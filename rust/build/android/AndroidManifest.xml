<?xml version="1.0" encoding="utf-8"?>
<!-- Zaxnes on Android: a gamepad-driven app (the console interface), its user data in its own
     folder on the shared storage, which needs no permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.nixxou.zaxnes"
    android:installLocation="auto">

    <!-- OpenGL ES 3.0 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- RetroAchievements. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Xnes3D+: the game list reads the player's own ROM folder, wherever it is. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:label="Zaxnes"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true">

        <activity
            android:name="io.github.nixxou.zaxnes.ZaxnesActivity"
            android:label="Zaxnes"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Xnes3D+: no "open this file" filter, so Xnes3D+ stays out of Android's
                 "Open with" list for zips and other files. A launcher starts a game by naming
                 this activity, which needs no filter: the ROM still comes as the intent's data
                 (see LaunchedRom). -->
        </activity>

        <!-- Xnes3D+: the Android half of Options > Games and 3D profiles (pickers,
             downloads), opened by the emulator itself, so it has no icon of its own; it also
             takes .3dn files opened or shared from a file manager (ProfilesActivity). -->
        <activity
            android:name="io.github.nixxou.zaxnes.ProfilesActivity"
            android:label="Zaxnes profiles"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="true">
            <!-- Share only (the share sheet, not "Open with"): .3dn and .bundle files. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- .3dn has no type of its own: file managers send it as "unknown file" -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
