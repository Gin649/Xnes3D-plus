<?xml version="1.0" encoding="utf-8"?>
<!-- Zaxnes on Android: a gamepad-driven app (the console interface), its user data in its own
     folder on the shared storage, which needs no permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.nixxou.zaxnes"
    android:installLocation="auto">

    <!-- OpenGL ES 3.0 -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- RetroAchievements. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Zaxnes"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true">

        <activity
            android:name="io.github.nixxou.zaxnes.ZaxnesActivity"
            android:label="Zaxnes"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:screenOrientation="sensorLandscape"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- A frontend starting a game: the data is the ROM (see LaunchedRom). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-nes-rom" />
            </intent-filter>
        </activity>

        <!-- Zaxnes profiles: picks the folder 3D profiles are copied from, and takes .3dn files
             opened or shared from a file manager (ProfilesActivity, ProfileFolder). -->
        <activity
            android:name="io.github.nixxou.zaxnes.ProfilesActivity"
            android:label="Zaxnes profiles"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- .3dn has no type of its own: file managers send it as "unknown file" -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
    </application>
</manifest>
